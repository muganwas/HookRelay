{
  "name": "hookrelay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node-pg-migrate",
    "start": "node dist/api.js",
    "typecheck": "tsc -p tsconfig.json",
    "worker": "tsx watch src/worker.ts",
    "enqueue": "tsx src/dev/enqueue-demo.ts",
    "test": "node --import tsx --test test/topics.test.ts test/actions.test.ts test/http.test.ts",
    "test:heavy": "node --import tsx --test test/heavy.test.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.16",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
